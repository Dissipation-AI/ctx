    make 'allowing as at for launcher named signed'
    rebuild 'as launcher'
    restart 'as server without'
    help ''
  )
  tab_after=(
    list 'in'
    read 'in read'
    find 'in'
    ask 'about'
    status ''
    open ''
    close 'close'
    rename 'rename'
    move 'move'
