    show 'show'
    attach 'to'
    install ''
    remove ''
    mcp ''
    make ''
    rebuild ''
    restart ''
    help ''
  )
  if [[ " ${tab_after[$verb]} " == *" $prev "* ]]; then
    local -a tabs
    tabs=("${(@f)$(command ctx completion-words tabs 2>/dev/null)}")
